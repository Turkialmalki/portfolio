# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything ignored except the committed template, which must
# contain variable NAMES ONLY, never a real value.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# transient frames from scripts/render-mobile-scenes.mjs
.mobile-scene-frames/

# transient compile output of `npm run test:methodology`
.methodology-tests-build/
.knowledge-tests-build/
.analysis-tests-build/
.parser-tests-build/
.determinism-tests-build/
.ats-tests-build/
