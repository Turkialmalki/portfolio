# Google Tag Manager — get ID from tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-WZ323H4Z

# Google Analytics 4 — configure inside GTM (preferred), or use directly
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity — get ID from clarity.microsoft.com
NEXT_PUBLIC_CLARITY_PROJECT_ID=XXXXXXXXXX

# ── Supabase — Career backend ────────────────────────────────────────────
#
# FRONTEND-SAFE (NEXT_PUBLIC_* — inlined into the static export, public by
# definition). Every privileged action either key can reach is gated by
# Postgres Row Level Security or by an Edge Function re-checking the caller;
# neither value is a secret.
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# ── BACKEND-ONLY — set these in the Supabase project's Edge Function
# secrets (`supabase secrets set …` or the dashboard), NEVER in this repo,
# NEVER prefixed NEXT_PUBLIC_, and NEVER read from any file that ships to
# the browser. Names only, no values, committed here so the shape of the
# secret set is documented without the secrets themselves. See
# docs/backend-architecture.md for which function reads which one.
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into every Edge Function by the Supabase runtime, locally
# and when hosted — they are never set by hand here or in Edge Function
# secrets.
#
# AI_PROVIDER_API_KEY   — the resume-analysis model provider, Edge Functions
#                          only. Read by resolveProvider() (Command 05) but
#                          no real adapter is implemented yet — its presence
#                          alone does not enable anything; the engine still
#                          runs on the deterministic mock provider until a
#                          real CareerAIProvider adapter is built.
# ADMIN_API_KEY          — shared secret gating verify-payment AND
#                          analyze-resume's fixture-test mode; held only by
#                          the future trusted admin tool, never the browser.
#                          analyze-resume has no other auth path — there is
#                          no customer-facing way to reach it while
#                          PRIVACY_SECURITY_EXECUTION_VERIFIED is false.
#
# The Career MVP's payment provider is a PayPal PAYMENT LINK
# (src/config/payments.ts) with MANUAL verification — see
# docs/backend-architecture.md. No PayPal API credential, no PayPal webhook
# secret, and no Lemon Squeezy credential is required for this phase: there
# is no automated PayPal integration yet, and Lemon Squeezy is retired as
# the active provider. Automating PayPal later (Part 12 of the payment
# correction) will add its own credential here when that work starts.
